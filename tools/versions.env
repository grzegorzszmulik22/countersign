# libatomic for linux/arm64 — the pinned Node binary links libatomic.so.1,
# which minimal hosts (e.g. Ubuntu 24.04 without gcc runtime libs) do not
# ship. Debian's libatomic1 deb is used because its data.tar.xz extracts
# without extra tooling; the .so needs only GLIBC_2.17 so it loads under any
# host glibc >= 2.17. sha256 is of the pinned .deb file.
LIBATOMIC_VERSION=14.2.0-19
LIBATOMIC_DEB=libatomic1_14.2.0-19_arm64.deb
LIBATOMIC_URL=https://ftp.debian.org/debian/pool/main/g/gcc-14/libatomic1_14.2.0-19_arm64.deb
LIBATOMIC_SHA256=7ccff90234484bf21ae5ecb79d25b6a84b2f4038f65dd139085b2e3a937cd8dc

CRYPTOGRAPHY_VERSION=50.0.2
CRYPTOGRAPHY_WHEEL=cryptography-50.0.2-cp311-abi3-manylinux_2_34_aarch64.whl
CRYPTOGRAPHY_WHEEL_URL=https://files.pythonhosted.org/packages/71/37/6202e488cc1eb625ea110c292c6bda92823176e023f427d8d5660ce8d632/cryptography-50.0.2-cp311-abi3-manylinux_2_34_aarch64.whl
CRYPTOGRAPHY_SHA256=87e9ce85beb6b328ba370cc6e6aea483c92617b4c95b1d33a49297eb662bfb04

