#
# Image pins for the hermetic kind cluster (M0.2). Every image is pulled by
# digest and must have a linux/arm64 variant (06-agent-loop.md §11). Digests
# are the multi-arch index digests recorded at pin time; the upstream record
# is kept in evidence/M0.2/*/upstream/.
#
# The kind node image itself is pinned as KIND_NODE_IMAGE in tools/versions.env.

# Calico CNI, installed from the pinned upstream manifest below.
CALICO_VERSION=v3.33.0
CALICO_MANIFEST=deploy/kind/calico-v3.33.0.yaml
CALICO_MANIFEST_URL=https://raw.githubusercontent.com/projectcalico/calico/v3.33.0/manifests/calico.yaml
# sha256 of the committed manifest file (includes the repo SPDX header; the
# byte-pure upstream sha256 2de8f475… is recorded in the header comment).
CALICO_MANIFEST_SHA256=f8aa1acaba60f3ff44180e26c1cd6be2314976f6d4febd966cb5ce72529fadc3

# IMAGE_REFS[i] is pulled by digest and tagged IMAGE_TAGS[i]; the tags are what
# in-cluster manifests reference (IfNotPresent -> the loaded copy is used).
IMAGE_REFS=(
    "quay.io/calico/calico@sha256:4ebc20730127bc9e8bf1db5f5a2d8b58cf37fe0e891b3c7b5471992221d213e5"
    "quay.io/calico/node@sha256:565d8db3200e443955557f8f28ff44ab8a4a456754bc74a19c4f2f3444af9b1c"
    "quay.io/calico/third-party-cni-plugins@sha256:0f32f48279484c0d6f0e0d0e767b2d0e1a6c6ca34cb3421a61b989d992f3df41"
    "registry.k8s.io/e2e-test-images/agnhost@sha256:352a050380078cb2a1c246357a0dfa2fcf243ee416b92ff28b44a01d1b4b0294"
    "docker.io/library/busybox@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec"
)
IMAGE_TAGS=(
    "quay.io/calico/calico:v3.33.0"
    "quay.io/calico/node:v3.33.0"
    "quay.io/calico/third-party-cni-plugins:v3.33.0"
    "registry.k8s.io/e2e-test-images/agnhost:2.56"
    "docker.io/library/busybox:1.37.0"
)
