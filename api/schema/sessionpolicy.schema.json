{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countersign.dev/schema/sessionpolicy.v1alpha1.schema.json",
  "title": "SessionPolicy",
  "description": "spec/04-policy-and-reconciliation.md §1 plus spec/05 autonomy/class fields (M5.2 scope). The 05 spec fields world, commit, budgets, tape, attest and the grant field egress are not yet admitted: additionalProperties is false throughout, so they are rejected as unknown and can be added later without breaking the schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "countersign.dev/v1alpha1"},
    "kind": {"const": "SessionPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["enforce", "audit", "learn"], "default": "enforce"},
        "scenario": {"enum": ["agent", "mcp-server"], "default": "agent"},
        "observer": {"enum": ["optional", "required"], "default": "optional"},
        "taint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initialWorkspace": {"type": "string", "pattern": "^(trusted|[a-z][a-z0-9-]*)$"}
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"previews": {"type": "boolean", "default": true}}
        },
        "bufferLimit": {"type": "string", "pattern": "^[0-9]+(B|K|Ki|M|Mi|G|Gi)?$"},
        "maxIntentOpenSeconds": {"type": "integer", "minimum": 1},
        "commandField": {"type": "string", "minLength": 1},
        "toolClasses": {
          "type": "object",
          "additionalProperties": {"enum": ["exec", "http", "mcp", "local", "other"]}
        },
        "autonomy": {
          "type": "object",
          "propertyNames": {"enum": ["control", "safe", "staged", "compensable", "irreversible"]},
          "additionalProperties": {"enum": ["allow", "review", "deny"]}
        },
        "grants": {
          "type": "array",
          "items": {"$ref": "#/$defs/grant"}
        }
      }
    }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action": {"enum": ["allow", "deny"], "default": "allow"},
        "match": {"$ref": "#/$defs/match"},
        "mode": {"enum": ["intercept", "passthrough"], "default": "intercept"},
        "upgrade": {"type": "array", "items": {"const": "websocket"}},
        "network": {"enum": ["public", "cluster"], "default": "public"},
        "inspect": {"enum": ["none", "inference", "mcp"], "default": "none"},
        "trust": {"type": "string", "pattern": "^(trusted|[a-z][a-z0-9-]*)$"},
        "class": {"enum": ["control", "safe", "staged", "compensable", "irreversible"]},
        "stager": {"$ref": "#/$defs/stager"},
        "compensate": {"$ref": "#/$defs/compensate"},
        "tools": {
          "type": "object",
          "additionalProperties": {"enum": ["control", "safe", "staged", "compensable", "irreversible"]}
        },
        "calls": {"const": "serialized"},
        "requires": {"enum": ["allow", "review", "deny"]},
        "intentMatch": {"enum": ["window", "exact"], "default": "window"},
        "lineage": {"enum": ["off", "preferred", "required"], "default": "preferred"},
        "whenTainted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {"enum": ["allow", "review", "deny"]},
            "labels": {
              "type": "object",
              "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
              "additionalProperties": {"enum": ["allow", "review", "deny"]}
            }
          }
        },
        "bufferLimit": {"type": "string", "pattern": "^[0-9]+(B|K|Ki|M|Mi|G|Gi)?$"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRequestBodyBytes": {"type": "integer", "minimum": 1},
            "maxUrlBytes": {"type": "integer", "minimum": 1},
            "requestsPerMinute": {"type": "integer", "minimum": 1}
          }
        },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "inject", "placeholderEnv"],
          "properties": {
            "ref": {
              "type": "object",
              "additionalProperties": false,
              "required": ["secret", "key"],
              "properties": {
                "secret": {"type": "string", "minLength": 1},
                "key": {"type": "string", "minLength": 1}
              }
            },
            "inject": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "header": {"type": "string", "pattern": "^[!#$%&'*+\\-.^_|~0-9A-Za-z]+$"},
                "format": {"type": "string", "pattern": "\\{secret\\}"},
                "basic": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["username"],
                  "properties": {"username": {"type": "string", "minLength": 1}}
                }
              }
            },
            "placeholderEnv": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          }
        }
      }
    },
    "stager": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refs"],
          "properties": {
            "refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^refs/"}},
            "allowDelete": {"type": "boolean"},
            "allowNonFastForward": {"type": "boolean"},
            "maxPackBytes": {"type": "string", "pattern": "^[0-9]+(B|K|Ki|M|Mi|G|Gi)?$"}
          }
        },
        "outbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["respond", "idMap"],
          "properties": {
            "respond": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "contentType", "body"],
              "properties": {
                "status": {"type": "integer", "minimum": 100, "maximum": 599},
                "contentType": {"type": "string", "minLength": 1},
                "body": {"type": "string"}
              }
            },
            "idMap": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provisional", "real"],
              "properties": {
                "provisional": {"type": "string", "pattern": "^/"},
                "real": {"type": "string", "pattern": "^/"}
              }
            },
            "idempotencyHeader": {"type": "string", "pattern": "^[!#$%&'*+\\-.^_|~0-9A-Za-z]+$"}
          }
        }
      }
    },
    "compensate": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"required": ["restore"]}, {"required": ["deleteCreated"]}],
      "properties": {
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["methods"],
          "properties": {
            "methods": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[!#$%&'*+\\-.^_|~0-9A-Za-z]+$"}}
          }
        },
        "deleteCreated": {
          "type": "object",
          "additionalProperties": false,
          "required": ["methods"],
          "properties": {
            "methods": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[!#$%&'*+\\-.^_|~0-9A-Za-z]+$"}},
            "from": {"oneOf": [
              {"const": "location"},
              {"type": "object", "additionalProperties": false, "required": ["jsonPointer"],
               "properties": {"jsonPointer": {"type": "string", "pattern": "^/"}}}
            ]},
            "urlTemplate": {"type": "string", "minLength": 1}
          }
        },
        "stateDigest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ignore": {"type": "array", "items": {"type": "string", "pattern": "^/"}}
          }
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(\\*|\\*\\.[a-z0-9]([a-z0-9.-]*[a-z0-9])?|[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*|[0-9a-fA-F:.]+|\\[[0-9a-fA-F:]+\\])$"
          }
        },
        "scheme": {"enum": ["https", "http"], "default": "https"},
        "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
        "methods": {"type": "array", "items": {"type": "string", "pattern": "^[!#$%&'*+\\-.^_|~0-9A-Za-z]+$"}},
        "paths": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
        "matcher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["git-smart-http"],
          "properties": {
            "git-smart-http": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repos", "access"],
              "properties": {
                "repos": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[^/]+/[^/]+$"}},
                "access": {"enum": ["read", "write"]}
              }
            }
          }
        }
      }
    }
  }
}
