{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countersign.dev/schema/records/effect.exec.json",
  "title": "countersign record effect.exec (03 §4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "session",
    "emitter",
    "eseq",
    "eprev",
    "ts",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "effect.exec"
    },
    "id": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "session": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "emitter": {
      "$ref": "_common.json#/$defs/emitter"
    },
    "eseq": {
      "type": "integer",
      "minimum": 0
    },
    "eprev": {
      "$ref": "_common.json#/$defs/hex64"
    },
    "ts": {
      "$ref": "_common.json#/$defs/ts"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exec_id",
        "parent_exec_id",
        "pid",
        "binary",
        "argv_sha256",
        "argv_truncated",
        "uid"
      ],
      "properties": {
        "exec_id": {
          "type": "string"
        },
        "parent_exec_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "pid": {
          "type": "integer"
        },
        "binary": {
          "type": "string"
        },
        "argv_sha256": {
          "type": "array",
          "items": {
            "$ref": "_common.json#/$defs/hex64"
          },
          "maxItems": 64
        },
        "argv_truncated": {
          "type": "boolean"
        },
        "uid": {
          "type": "integer"
        }
      }
    }
  }
}
