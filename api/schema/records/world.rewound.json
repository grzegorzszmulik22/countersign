{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countersign.dev/schema/records/world.rewound.json",
  "title": "countersign record world.rewound (03 §4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "session",
    "emitter",
    "eseq",
    "eprev",
    "ts",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "world.rewound"
    },
    "id": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "session": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "emitter": {
      "$ref": "_common.json#/$defs/emitter"
    },
    "eseq": {
      "type": "integer",
      "minimum": 0
    },
    "eprev": {
      "$ref": "_common.json#/$defs/hex64"
    },
    "ts": {
      "$ref": "_common.json#/$defs/ts"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to_journal_seq",
        "dropped_entries",
        "undo_id"
      ],
      "properties": {
        "to_journal_seq": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "undo_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    }
  }
}
