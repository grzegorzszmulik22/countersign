{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countersign.dev/schema/records/effect.http.result.json",
  "title": "countersign record effect.http.result (03 §4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "session",
    "emitter",
    "eseq",
    "eprev",
    "ts",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "effect.http.result"
    },
    "id": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "session": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "emitter": {
      "$ref": "_common.json#/$defs/emitter"
    },
    "eseq": {
      "type": "integer",
      "minimum": 0
    },
    "eprev": {
      "$ref": "_common.json#/$defs/hex64"
    },
    "ts": {
      "$ref": "_common.json#/$defs/ts"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "served_by",
        "status",
        "response",
        "request_body",
        "upstream",
        "timing",
        "scrubbed",
        "error"
      ],
      "properties": {
        "effect_id": {
          "type": "string"
        },
        "served_by": {
          "type": "string",
          "enum": [
            "upstream",
            "world",
            "boundary",
            "replay"
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "header_names",
            "body_sha256",
            "body_len"
          ],
          "properties": {
            "header_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "body_sha256": {
              "$ref": "_common.json#/$defs/hex64"
            },
            "body_len": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "request_body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "len"
          ],
          "properties": {
            "sha256": {
              "$ref": "_common.json#/$defs/hex64"
            },
            "len": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "upstream": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ip",
                "port",
                "tls_version",
                "cert_sha256"
              ],
              "properties": {
                "ip": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "tls_version": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "cert_sha256": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "_common.json#/$defs/hex64"
                    }
                  ]
                }
              }
            }
          ]
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_ms",
            "ttfb_ms"
          ],
          "properties": {
            "total_ms": {
              "type": "number"
            },
            "ttfb_ms": {
              "type": "number"
            }
          }
        },
        "scrubbed": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    }
  }
}
