{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countersign.dev/schema/records/commit.closed.json",
  "title": "countersign record commit.closed (03 §4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "session",
    "emitter",
    "eseq",
    "eprev",
    "ts",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "commit.closed"
    },
    "id": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "session": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "emitter": {
      "$ref": "_common.json#/$defs/emitter"
    },
    "eseq": {
      "type": "integer",
      "minimum": 0
    },
    "eprev": {
      "$ref": "_common.json#/$defs/hex64"
    },
    "ts": {
      "$ref": "_common.json#/$defs/ts"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_id",
        "outcome"
      ],
      "properties": {
        "commit_id": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "committed",
            "partial",
            "rejected",
            "expired",
            "rolled-back"
          ]
        }
      }
    }
  }
}
