{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countersign.dev/schema/records/commit.requested.json",
  "title": "countersign record commit.requested (03 §4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "session",
    "emitter",
    "eseq",
    "eprev",
    "ts",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "commit.requested"
    },
    "id": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "session": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "emitter": {
      "$ref": "_common.json#/$defs/emitter"
    },
    "eseq": {
      "type": "integer",
      "minimum": 0
    },
    "eprev": {
      "$ref": "_common.json#/$defs/hex64"
    },
    "ts": {
      "$ref": "_common.json#/$defs/ts"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_id",
        "trigger",
        "entries",
        "changeset_root",
        "review_sha256",
        "invariants",
        "auto_eligible",
        "expires_at"
      ],
      "properties": {
        "commit_id": {
          "type": "string"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "agent",
            "operator",
            "session-end",
            "barrier",
            "held-effect"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changeset_root": {
          "$ref": "_common.json#/$defs/hex64"
        },
        "review_sha256": {
          "$ref": "_common.json#/$defs/hex64"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "pass",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "pass": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "auto_eligible": {
          "type": "boolean"
        },
        "expires_at": {
          "$ref": "_common.json#/$defs/ts"
        }
      }
    }
  }
}
