{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countersign.dev/schema/records/commit.applied.json",
  "title": "countersign record commit.applied (03 §4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "session",
    "emitter",
    "eseq",
    "eprev",
    "ts",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "commit.applied"
    },
    "id": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "session": {
      "$ref": "_common.json#/$defs/ulid"
    },
    "emitter": {
      "$ref": "_common.json#/$defs/emitter"
    },
    "eseq": {
      "type": "integer",
      "minimum": 0
    },
    "eprev": {
      "$ref": "_common.json#/$defs/hex64"
    },
    "ts": {
      "$ref": "_common.json#/$defs/ts"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_id",
        "entry_id",
        "outcome",
        "via_effect",
        "precondition",
        "id_map"
      ],
      "properties": {
        "commit_id": {
          "type": "string"
        },
        "entry_id": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "applied",
            "conflict",
            "failed",
            "unknown"
          ]
        },
        "via_effect": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expected",
            "observed"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "expected": {},
            "observed": {}
          }
        },
        "id_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
