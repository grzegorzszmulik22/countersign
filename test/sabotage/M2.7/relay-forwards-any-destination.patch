+
+// spliceBuf is splice with the client side's buffered remainder drained.
+func spliceBuf(br *bufio.Reader, a, b net.Conn) {
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		_, _ = io.Copy(b, br)
+		if tc, ok := b.(*net.TCPConn); ok {
+			_ = tc.CloseWrite()
+		}
+		wg.Done()
+	}()
+	go func() {
+		_, _ = io.Copy(a, b)
+		wg.Done()
+	}()
+	wg.Wait()
+	_ = a.Close()
+	_ = b.Close()
 }
 
 // splice copies both directions and propagates half-close.
