+// spliceBuf is splice with the client side's buffered remainder drained.
+func spliceBuf(br *bufio.Reader, a, b net.Conn) error {
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	var first error
+	report := func(err error) {
+		if err == nil {
+			return
+		}
+		mu.Lock()
+		if first == nil {
+			first = err
+		}
+		mu.Unlock()
+	}
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		_, err := io.Copy(b, br)
+		report(err)
+		if tc, ok := b.(*net.TCPConn); ok {
+			_ = tc.CloseWrite()
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		_, err := io.Copy(a, b)
+		report(err)
+		if uc, ok := a.(*net.UnixConn); ok {
+			_ = uc.CloseWrite()
+		}
+	}()
+	wg.Wait()
+	_ = a.Close()
+	_ = b.Close()
+	return first
+}
+
 // splice copies both directions and propagates half-close. Copy errors
 // are reported to the caller: a truncated stream through the boundary
 // is a boundary event, not silence.
